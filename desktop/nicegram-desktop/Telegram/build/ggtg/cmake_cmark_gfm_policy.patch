diff --git a/external/cmark_gfm/CMakeLists.txt b/external/cmark_gfm/CMakeLists.txt
index 20dfca8..ce52e7a 100644
--- a/external/cmark_gfm/CMakeLists.txt
+++ b/external/cmark_gfm/CMakeLists.txt
@@ -39,6 +39,17 @@ block()
     # __imp__ thunks that fail to link against tdesktop's static-CRT code.
     set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
 
+    # CMake >= 4.4 errors (as a *policy* error under tdesktop's -Werror=dev,
+    # not something CMAKE_SUPPRESS_DEVELOPER_WARNINGS below covers) the
+    # moment CMAKE_ERROR_DEPRECATED/CMAKE_WARN_DEPRECATED are read below.
+    # The CMAKE_POLICY_DEFAULT_CMP0218 variable doesn't reach this far (no
+    # cmake_minimum_required() bump in this scope to key off), so set the
+    # policy directly - OLD keeps those variables meaningful, matching
+    # what this block was already written to expect.
+    if (POLICY CMP0218)
+        cmake_policy(SET CMP0218 OLD)
+    endif()
+
     # Normal-variable overrides for cmark-gfm's options(). With CMP0077
     # NEW (lifted above) these beat the hardcoded option() defaults
     # without any CACHE writes. BUILD_TESTING is intentionally NOT set:
