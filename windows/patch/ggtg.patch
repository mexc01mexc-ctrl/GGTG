+void ProxyBox::applyQuickPaste() {
+	// One-line "ip:port:login:pass" quick-fill - splits on ':', with the
+	// password taking everything after the third colon so a password
+	// that itself contains ':' doesn't get truncated. An "http://" prefix
+	// selects the HTTP proxy type instead of the SOCKS5 default. Re-run on
+	// every collectData() call (Save/Check/Share), not just on Enter, so
+	// they always act on whatever is currently visible in the field.
+	auto text = _quickPaste->getLastText().trimmed();
+	auto type = Type::Socks5;
+	const auto httpPrefix = u"http://"_q;
+	if (text.startsWith(httpPrefix, Qt::CaseInsensitive)) {
+		type = Type::Http;
+		text = text.mid(httpPrefix.size());
+	}
+	const auto parts = text.split(':');
+	if (parts.size() < 2) {
+		return;
+	}
+	const auto port = parts[1].trimmed().toUShort();
+	if (!port) {
+		return;
+	}
+	_host->setText(parts[0].trimmed());
+	_port->setText(QString::number(port));
+	_user->setText(parts.size() > 2 ? parts[2].trimmed() : QString());
+	_password->setText(parts.size() > 3
+		? QStringList(parts.mid(3)).join(':').trimmed()
+		: QString());
+	_type->setValue(type);
 }
 
