+	// list picker whenever any saved list existed (skipping this view
+	// entirely) meant there was no way to just look at what's already set.
+	// "Replace" inside the box below is the way into that same picker now.
+	const auto pickFromList = [=](Fn<void(ProxyData)> apply) {
+		Ui::show(
+			MakeProxyListPickerBox(current, [=](const MTP::ProxyData &proxy) {
+				apply(proxy);
+			}),
+			Ui::LayerOption::KeepOther);
+	};
+	return Box<ProxyBox>(
+		current,
+		submit,
+		Fn<void(ProxyData)>(),
+		pickFromList);
+}
+
+object_ptr<Ui::BoxContent> MakeManualProxyBox(
+		Fn<void(const MTP::ProxyData &proxy)> submit) {
+	return Box<ProxyBox>(
+		ProxyData(),
+		[=](const ProxyData &result) { submit(result); },
+		Fn<void(ProxyData)>());
+}
+
+[[nodiscard]] QString DescribeProxyPoolEntry(const MTP::ProxyData &entry) {
+	auto result = entry.host + u":"_q + QString::number(entry.port);
+	if (!entry.user.isEmpty()) {
+		result += u" ("_q + entry.user + ')';
+	}
+	return result;
+}
+
+[[nodiscard]] QString DescribeProxyList(const MTP::ProxyList &list) {
+	const auto name = list.name.isEmpty() ? u"(unnamed)"_q : list.name;
+	return name + u" ("_q + QString::number(list.entries.size()) + ')';
+}
+
+object_ptr<Ui::BoxContent> MakeProxyListPickerBox(
+		const MTP::ProxyData &current,
+		Fn<void(const MTP::ProxyData &proxy)> submit) {
+	return Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Choose a proxy list"_q));
+		const auto &lists = MTP::GlobalProxyPool().lists();
+		for (auto i = 0; i != int(lists.size()); ++i) {
+			if (lists[i].entries.empty()) {
+				continue;
+			}
+			const auto button = box->addRow(object_ptr<Ui::SettingsButton>(
+				box.get(),
+				rpl::single(DescribeProxyList(lists[i])),
+				st::settingsButton));
+			button->setAcceptBoth(true);
+			button->clicks(
+			) | rpl::on_next([=](Qt::MouseButton) {
+				// Peek, don't take: the entry is only actually removed
+				// from its list once the caller confirms the add it was
+				// used for succeeded (see ProxyPool::removeMatching) -
+				// otherwise a failed attempt would silently burn through
+				// the whole pool for nothing.
+				const auto picked = MTP::GlobalProxyPool().peek(i);
+				// Close this transient box *before* invoking submit(),
+				// which may swap out the whole window's content (a new
+				// account with no session shows the login screen) - if
+				// that runs while this box still thinks it's on top,
+				// the transition can silently get lost.
+				box->closeBox();
+				if (picked) {
+					submit(*picked);
+				}
+			}, button->lifetime());
+		}
+		box->addButton(rpl::single(u"Enter manually..."_q), [=] {
+			box->closeBox();
+			Ui::show(Box<ProxyBox>(
+				current,
+				[=](const ProxyData &result) { submit(result); },
+				Fn<void(ProxyData)>()));
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	});
+}
+
+object_ptr<Ui::BoxContent> MakeNewProxyBox(
+		Fn<void(const MTP::ProxyData &proxy)> submit) {
+	const auto &lists = MTP::GlobalProxyPool().lists();
+	const auto hasAny = ranges::any_of(lists, [](const MTP::ProxyList &list) {
+		return !list.entries.empty();
+	});
+	if (!hasAny) {
+		return MakeManualProxyBox(submit);
+	}
+	return MakeProxyListPickerBox(MTP::ProxyData(), submit);
+}
+
+object_ptr<Ui::BoxContent> MakeMultiProxyBox(
+		Fn<void(Fn<MTP::ProxyData()> nextProxy)> submit) {
+	const auto &lists = MTP::GlobalProxyPool().lists();
+	const auto hasAny = ranges::any_of(lists, [](const MTP::ProxyList &list) {
+		return !list.entries.empty();
+	});
+	if (!hasAny) {
+		// No lists to pull several distinct entries from - the one proxy
+		// typed in manually ends up shared by every imported account.
+		return MakeManualProxyBox([=](const MTP::ProxyData &proxy) {
+			submit([proxy] { return proxy; });
+		});
+	}
+	return Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Choose a proxy list"_q));
+		for (auto i = 0; i != int(lists.size()); ++i) {
+			if (lists[i].entries.empty()) {
+				continue;
+			}
+			const auto button = box->addRow(object_ptr<Ui::SettingsButton>(
+				box.get(),
+				rpl::single(DescribeProxyList(lists[i])),
+				st::settingsButton));
+			button->setAcceptBoth(true);
+			button->clicks(
+			) | rpl::on_next([=](Qt::MouseButton) {
+				box->closeBox();
+				// Pulls a fresh, distinct entry from this same list for
+				// every account being imported - once the list runs dry,
+				// the rest fall back to a placeholder that can never
+				// actually connect, rather than silently sharing one
+				// proxy or connecting unproxied.
+				submit([i] {
+					if (const auto taken = MTP::GlobalProxyPool().take(i)) {
+						return *taken;
+					}
+					return MTP::UnreachableProxyPlaceholder();
+				});
+			}, button->lifetime());
+		}
+		box->addButton(rpl::single(u"Enter manually..."_q), [=] {
+			box->closeBox();
+			Ui::show(MakeManualProxyBox([=](const MTP::ProxyData &proxy) {
+				submit([proxy] { return proxy; });
+			}));
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	});
+}
+
+object_ptr<Ui::BoxContent> MakeProxyListEditorBox(int listIndex) {
+	return Box([=](not_null<Ui::GenericBox*> box) {
+		const auto &lists = MTP::GlobalProxyPool().lists();
+		if (listIndex < 0 || listIndex >= int(lists.size())) {
+			box->closeBox();
+			return;
+		}
+		box->setTitle(rpl::single(u"Edit proxy list"_q));
+
+		const auto nameField = box->addRow(object_ptr<Ui::InputField>(
+			box.get(),
+			st::defaultInputField,
+			rpl::single(u"List name"_q),
+			lists[listIndex].name));
+		nameField->submits(
+		) | rpl::on_next([=] {
+			MTP::GlobalProxyPool().renameList(
+				listIndex,
+				nameField->getLastText().trimmed());
+		}, nameField->lifetime());
+
+		Ui::AddSkip(box->verticalLayout());
+		const auto &entries = lists[listIndex].entries;
+		if (entries.empty()) {
+			box->addRow(object_ptr<Ui::FlatLabel>(
+				box.get(),
+				u"List is empty."_q,
+				st::boxLabel));
+		} else {
+			for (auto i = 0; i != int(entries.size()); ++i) {
+				const auto row = box->addRow(object_ptr<Ui::SettingsButton>(
+					box.get(),
+					rpl::single(
+						u"✕ "_q + DescribeProxyPoolEntry(entries[i])),
+					st::settingsButton));
+				row->setAcceptBoth(true);
+				row->clicks(
+				) | rpl::on_next([=](Qt::MouseButton) {
+					MTP::GlobalProxyPool().removeEntry(listIndex, i);
+					box->closeBox();
+					Ui::show(MakeProxyListEditorBox(listIndex));
+				}, row->lifetime());
+			}
+		}
+
+		Ui::AddSkip(box->verticalLayout());
+		Ui::AddDivider(box->verticalLayout());
+		Ui::AddSkip(box->verticalLayout());
+
+		const auto addField = box->addRow(object_ptr<Ui::InputField>(
+			box.get(),
+			st::defaultInputField,
+			Ui::InputField::Mode::MultiLine,
+			rpl::single(u"ip:port:login:pass (one per line)"_q)));
+		box->addButton(rpl::single(u"Add"_q), [=] {
+			MTP::GlobalProxyPool().renameList(
+				listIndex,
+				nameField->getLastText().trimmed());
+			MTP::GlobalProxyPool().addLines(listIndex, addField->getLastText());
+			box->closeBox();
+			Ui::show(MakeProxyListEditorBox(listIndex));
+		});
+		box->addButton(rpl::single(u"Delete this list"_q), [=] {
+			MTP::GlobalProxyPool().removeList(listIndex);
+			box->closeBox();
+			Ui::show(MakeProxyPoolManagerBox());
+		});
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	});
+}
+
+object_ptr<Ui::BoxContent> MakeProxyPoolManagerBox() {
+	return Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Proxy lists"_q));
+		const auto &lists = MTP::GlobalProxyPool().lists();
+		if (lists.empty()) {
+			box->addRow(object_ptr<Ui::FlatLabel>(
+				box.get(),
+				u"No lists yet - create one below."_q,
+				st::boxLabel));
+		} else {
+			for (auto i = 0; i != int(lists.size()); ++i) {
+				const auto row = box->addRow(object_ptr<Ui::SettingsButton>(
+					box.get(),
+					rpl::single(DescribeProxyList(lists[i])),
+					st::settingsButton));
+				row->setAcceptBoth(true);
+				row->clicks(
+				) | rpl::on_next([=](Qt::MouseButton) {
+					box->closeBox();
+					Ui::show(MakeProxyListEditorBox(i));
+				}, row->lifetime());
+			}
+		}
+
+		Ui::AddSkip(box->verticalLayout());
+		Ui::AddDivider(box->verticalLayout());
+		Ui::AddSkip(box->verticalLayout());
+
+		const auto nameField = box->addRow(object_ptr<Ui::InputField>(
+			box.get(),
+			st::defaultInputField,
+			rpl::single(u"New list name (e.g. India)"_q)));
+		box->addButton(rpl::single(u"Create list"_q), [=] {
+			const auto name = nameField->getLastText().trimmed();
+			if (name.isEmpty()) {
+				return;
+			}
+			const auto index = MTP::GlobalProxyPool().addList(name);
+			box->closeBox();
+			Ui::show(MakeProxyListEditorBox(index));
+		});
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	});
+}
+
+object_ptr<Ui::BoxContent> MakeProxyCheckBox(const MTP::ProxyData &proxy) {
+	return Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Proxy check"_q));
+		const auto label = box->addRow(object_ptr<Ui::FlatLabel>(
+			box.get(),
+			u"Checking..."_q,
+			st::boxLabel));
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+
+		if (proxy.type == ProxyData::Type::None || proxy.host.isEmpty()) {
+			label->setText(u"No proxy entered to check."_q);
+			return;
+		} else if (proxy.type == ProxyData::Type::Mtproto) {
+			label->setText(u"MTProto proxies can't be checked this way - "
+				"they only relay Telegram's own protocol, not generic "
+				"HTTP requests. If it lets this account connect at all, "
+				"it's working."_q);
+			return;
+		}
+
+		struct State final : QObject {
+			QNetworkAccessManager manager;
+		};
+		const auto state = box->lifetime().make_state<State>();
+		state->manager.setProxy(MTP::ToNetworkProxy(proxy));
+		const auto weak = base::make_weak(box);
+
+		const auto showIp = [=](const QString &ip, const QString &country) {
+			auto text = TextWithEntities{ u"Proxy is working. Exit IP: "_q };
+			text.append(Ui::Text::Link(ip));
+			if (!country.isEmpty()) {
+				text.append(u" ("_q + country + u")"_q);
+			}
+			label->setMarkedText(text);
+			label->setClickHandlerFilter([=](const auto &...) {
+				TextUtilities::SetClipboardText(TextForMimeData::Simple(ip));
+				box->uiShow()->showToast(u"IP copied to clipboard"_q);
+				return false;
+			});
+		};
+		// ipify is the last-resort fallback (IP only, no country) if
+		// neither geo-lookup service below responds.
+		const auto checkViaIpify = [=] {
+			auto request = QNetworkRequest(QUrl(u"https://api.ipify.org"_q));
+			const auto reply = state->manager.get(request);
+			QObject::connect(reply, &QNetworkReply::finished, [=] {
+				if (!weak) {
+					reply->deleteLater();
+					return;
+				}
+				if (reply->error() != QNetworkReply::NoError) {
+					label->setText(
+						u"Proxy is not working: "_q + reply->errorString());
+				} else {
+					const auto ip = QString::fromUtf8(
+						reply->readAll()).trimmed();
+					if (ip.isEmpty()) {
+						label->setText(
+							u"Proxy is not working: bad response."_q);
+					} else {
+						showIp(ip, QString());
+					}
+				}
+				reply->deleteLater();
+			});
+		};
+		// ipapi.co as a secondary source, tried only if ip-api.com itself
+		// is unreachable through this proxy (not just "status":"fail").
+		const auto checkViaIpapi = [=] {
+			auto request = QNetworkRequest(QUrl(u"https://ipapi.co/json/"_q));
+			const auto reply = state->manager.get(request);
+			QObject::connect(reply, &QNetworkReply::finished, [=] {
+				if (!weak) {
+					reply->deleteLater();
+					return;
+				}
+				if (reply->error() != QNetworkReply::NoError) {
+					reply->deleteLater();
+					checkViaIpify();
+					return;
+				}
+				const auto object = QJsonDocument::fromJson(
+					reply->readAll()).object();
+				const auto ip = object.value(u"ip"_q).toString();
+				const auto country = object.value(
+					u"country_name"_q).toString();
+				reply->deleteLater();
+				if (ip.isEmpty()) {
+					checkViaIpify();
+					return;
+				}
+				showIp(ip, country);
+			});
+		};
+
+		// ip-api.com is the primary source: unlike ipapi.co, it doesn't
+		// reject requests from proxy/hosting/datacenter IP ranges with a
+		// blanket 403, which is exactly what most of these proxies are.
+		// HTTP-only on the free tier, but that's fine - this goes through
+		// the proxy being tested either way, not a direct connection.
+		auto request = QNetworkRequest(QUrl(u"http://ip-api.com/json/"_q));
+		const auto reply = state->manager.get(request);
+		QObject::connect(reply, &QNetworkReply::finished, [=] {
+			if (!weak) {
+				reply->deleteLater();
+				return;
+			}
+			if (reply->error() != QNetworkReply::NoError) {
+				reply->deleteLater();
+				checkViaIpapi();
+				return;
+			}
+			const auto object = QJsonDocument::fromJson(
+				reply->readAll()).object();
+			const auto ip = object.value(u"query"_q).toString();
+			const auto country = object.value(u"country"_q).toString();
+			const auto ok = object.value(u"status"_q).toString() == u"success"_q;
+			reply->deleteLater();
+			if (!ok || ip.isEmpty()) {
+				checkViaIpapi();
+				return;
+			}
+			showIp(ip, country);
+		});
+	});
+}
