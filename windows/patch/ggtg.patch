+		}
+		return;
+	}
+	if (!_accountFolderKey) {
+		_accountFolderKey = GenerateKey(_basePath);
+		writeMapQueued();
+	}
+	const auto size = Serialize::stringSize(folder);
+	EncryptedDescriptor data(size);
+	data.stream << folder;
+
+	FileWriteDescriptor file(_accountFolderKey, _basePath);
+	file.writeEncrypted(data, _localKey);
