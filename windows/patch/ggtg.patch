+void Account::writeProxySettings(const MTP::ProxyData &proxy) {
+	if (proxy.type == MTP::ProxyData::Type::None) {
+		if (_proxySettingsKey) {
+			ClearKey(_proxySettingsKey, _basePath);
+			_proxySettingsKey = 0;
+			writeMapDelayed();
+		}
+		return;
+	}
+	if (!_proxySettingsKey) {
+		_proxySettingsKey = GenerateKey(_basePath);
+		writeMapQueued();
+	}
+	quint32 size = sizeof(quint32) * 2
+		+ Serialize::stringSize(proxy.host)
+		+ Serialize::stringSize(proxy.user)
+		+ Serialize::stringSize(proxy.password);
+	EncryptedDescriptor data(size);
+	data.stream
+		<< quint32(proxy.type)
+		<< quint32(proxy.port)
+		<< proxy.host
+		<< proxy.user
+		<< proxy.password;
+
+	FileWriteDescriptor file(_proxySettingsKey, _basePath);
+	file.writeEncrypted(data, _localKey);
+}
+
+MTP::ProxyData Account::readProxySettings() {
+	if (!_proxySettingsKey) {
+		return MTP::ProxyData();
+	}
+
+	FileReadDescriptor file;
+	if (!ReadEncryptedFile(file, _proxySettingsKey, _basePath, _localKey)) {
+		ClearKey(_proxySettingsKey, _basePath);
+		_proxySettingsKey = 0;
+		writeMapDelayed();
+		return MTP::ProxyData();
+	}
+
+	quint32 type = 0, port = 0;
+	QString host, user, password;
+	file.stream >> type >> port >> host >> user >> password;
+	if (file.stream.status() != QDataStream::Ok) {
+		return MTP::ProxyData();
+	}
+	auto result = MTP::ProxyData();
+	result.type = static_cast<MTP::ProxyData::Type>(type);
+	result.port = port;
+	result.host = host;
+	result.user = user;
+	result.password = password;
+	return result;
+}
+
+void Account::writeFolderTag(const QString &folder) {
